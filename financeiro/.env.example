# URL base da Bimer Core API instalada no servidor (sem barra no final)
# Ex.: http://10.0.0.5/bimerapi  ou  https://erp.suaempresa.com.br/bimerapi
BIMER_API_URL=http://localhost/bimerapi

# Usuário e senha cadastrados no módulo "Cadastro de Usuário" do Bimer,
# com permissão de acesso à API (rota /auth/token)
BIMER_USERNAME=
BIMER_PASSWORD=

# Código da empresa padrão usada quando o front não informa uma (ver /api/empresas)
BIMER_CODIGO_EMPRESA_PADRAO=1

# Porta em que este app vai rodar
PORT=3001
