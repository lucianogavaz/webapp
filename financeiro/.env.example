# URL base da Bimer Core API instalada no servidor (sem barra no final)
# Ex.: http://10.0.0.5/bimerapi  ou  https://erp.suaempresa.com.br/bimerapi
BIMER_API_URL=http://localhost/bimerapi

# Usuário e senha cadastrados no módulo "Cadastro de Usuário" do Bimer,
# com permissão de acesso à API (rota /auth/token)
BIMER_USERNAME=
BIMER_PASSWORD=

# Código da empresa padrão usada quando o front não informa uma (ver /api/empresas)
BIMER_CODIGO_EMPRESA_PADRAO=1

# Porta em que este app vai rodar
PORT=3001

# ── Acesso direto ao banco SQL Server do Bimer (SOMENTE LEITURA) ──────────
# Usado só para BP/DRE contábil, já que a API REST não expõe essas rotas.
# Preencha só se for usar essas telas. Recomendado usar um login de banco
# com permissão apenas de SELECT (não o mesmo usuário da aplicação Bimer).
# Use o IP se o hostname (Data Source) não resolver na sua rede.
BIMER_DB_SERVER=
BIMER_DB_PORT=1433
BIMER_DB_DATABASE=ERP
BIMER_DB_USER=
BIMER_DB_PASSWORD=
# true só se o SQL Server tiver certificado TLS configurado (raro em on-prem)
BIMER_DB_ENCRYPT=false
